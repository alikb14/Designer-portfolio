# Public runtime configuration. These values are intentionally visible in the browser.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=development

# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=replace-with-server-only-viewer-token
SANITY_REVALIDATE_SECRET=replace-with-a-random-server-only-secret
SANITY_STUDIO_ORIGIN=http://localhost:3000

# Risk-spike routes are available in development. Set explicitly for a deployed preview.
ENABLE_RISK_SPIKES=false
